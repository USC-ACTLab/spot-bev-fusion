# Compute installation prefix relative to this file.
get_filename_component(_dir "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
get_filename_component(_prefix "${_dir}/../.." ABSOLUTE)

find_package(CUDA REQUIRED)
find_package(Protobuf REQUIRED)

# Import the targets.
include("${_prefix}/lib/bevfusion/bevfusion-targets.cmake")

set(bevfusion_INCLUDE_DIRS
    "${_prefix}/include/bevfusion/"
    "${_prefix}/include/bevfusion/cuOSD/"
    "${_prefix}/include/bevfusion/dlpack/include/"
    "${_prefix}/include/bevfusion/pybind11/include/"
    "${_prefix}/include/bevfusion/spconv/"
    "${_prefix}/include/bevfusion/stb/"
    ${Protobuf_INCLUDE_DIRS}
    ${CUDA_INCLUDE_DIRS}
    $ENV{TensorRT_Inc}
    $ENV{Python_Inc}
)
set(bevfusion_LIBRARIES 
    -L${_prefix}/lib/bevfusion
    -L${CUDA_TOOLKIT_ROOT_DIR}/lib64
    -lcudart
    -lcublasLt
    -lnvinfer
    ${Protobuf_LIBRARIES}
    -lnvinfer_plugin
)
set(bevfusion_DEFINITIONS ${CUDA_DEFINITIONS})
